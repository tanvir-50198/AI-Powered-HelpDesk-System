@model List<KnowledgeDocument>
@{
    ViewData["Title"] = "Knowledge base";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Knowledge base (@Model.Count documents)</h2>
    <div class="d-flex gap-2">
        <form asp-action="ImportFolder" method="post">
            <button type="submit" class="btn btn-outline-secondary">Import KnowledgeBase folder</button>
        </form>
        <a class="btn btn-primary" asp-action="Upload">Upload document</a>
    </div>
</div>
<p class="text-muted">The chatbot only uses documents that are <strong>Approved</strong>, <strong>Indexed</strong> and meant for the <strong>Customer</strong> audience.</p>

<div class="card">
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr><th>Title</th><th>Category</th><th>Audience</th><th>Approval</th><th>Indexing</th><th>Ver.</th><th>Updated</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (KnowledgeDocument document in Model)
                {
                    string approvalCss = "bg-secondary";
                    if (document.ApprovalStatus == ApprovalStatus.Approved) { approvalCss = "bg-success"; }
                    else if (document.ApprovalStatus == ApprovalStatus.Rejected) { approvalCss = "bg-danger"; }

                    string processingCss = "bg-secondary";
                    if (document.ProcessingStatus == ProcessingStatus.Indexed) { processingCss = "bg-success"; }
                    else if (document.ProcessingStatus == ProcessingStatus.Failed) { processingCss = "bg-danger"; }

                    <tr>
                        <td><a asp-action="Details" asp-route-id="@document.Id">@document.Title</a></td>
                        <td>@document.Category</td>
                        <td>@document.Audience</td>
                        <td><span class="badge @approvalCss">@document.ApprovalStatus</span></td>
                        <td>
                            <span class="badge @processingCss">@document.ProcessingStatus</span>
                            @if (!string.IsNullOrEmpty(document.ProcessingError))
                            {
                                <div class="small text-danger">@document.ProcessingError</div>
                            }
                        </td>
                        <td>@document.Version</td>
                        <td>@document.UpdatedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-nowrap">
                            <form asp-action="Approve" asp-route-id="@document.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-success">Approve</button></form>
                            <form asp-action="Reject" asp-route-id="@document.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-warning">Reject</button></form>
                            <form asp-action="Reindex" asp-route-id="@document.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-primary">Re-index</button></form>
                            <form asp-action="Delete" asp-route-id="@document.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this document?');"><button class="btn btn-sm btn-outline-danger">Delete</button></form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
