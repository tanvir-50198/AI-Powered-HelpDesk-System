@model TicketDetailsViewModel
@{
    Ticket ticket = Model.Ticket;
    ViewData["Title"] = "Ticket #" + ticket.Id;
}

<a asp-action="Index" class="small">&laquo; Back to tickets</a>

<div class="d-flex justify-content-between align-items-start my-2">
    <h2 class="mb-0">#@ticket.Id - @ticket.Title</h2>
    <div>
        <partial name="_StatusBadge" model="ticket.Status" />
        <partial name="_PriorityBadge" model="ticket.Priority" />
    </div>
</div>
<p class="text-muted">
    Category: @ticket.Category.Name |
    Created by: @ticket.CreatedByUser.Email |
    Agent: @(ticket.AssignedAgent != null ? ticket.AssignedAgent.Email : "not assigned yet") |
    Created: @ticket.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC
</p>

<div class="row">
    <!-- Left side: description, resolution, comments -->
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">Description</div>
            <div class="card-body" style="white-space: pre-wrap;">@ticket.Description</div>
        </div>

        @if (!string.IsNullOrEmpty(ticket.ResolutionDetails))
        {
            <div class="card border-success mb-3">
                <div class="card-header bg-success text-white">Resolution</div>
                <div class="card-body" style="white-space: pre-wrap;">@ticket.ResolutionDetails</div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header">Comments (@ticket.Comments.Count)</div>
            <div class="card-body">
                @if (ticket.Comments.Count == 0)
                {
                    <p class="text-muted">No comments yet.</p>
                }
                @foreach (TicketComment comment in ticket.Comments)
                {
                    <div class="border-bottom pb-2 mb-2">
                        <div class="small text-muted">@comment.Author.Email - @comment.CreatedAt.ToString("dd MMM yyyy HH:mm")</div>
                        <div style="white-space: pre-wrap;">@comment.Body</div>
                    </div>
                }

                @if (Model.CanComment)
                {
                    <form asp-action="AddComment" asp-route-id="@ticket.Id" method="post" class="mt-3">
                        <textarea name="body" class="form-control mb-2" rows="3" maxlength="2000" placeholder="Write a comment..." required></textarea>
                        <button type="submit" class="btn btn-primary btn-sm">Add comment</button>
                    </form>
                }
                else
                {
                    <p class="text-muted mb-0">This ticket is closed. New comments are not allowed.</p>
                }
            </div>
        </div>
    </div>

    <!-- Right side: management + history -->
    <div class="col-lg-4">
        @if (Model.IsAdmin)
        {
            <div class="card mb-3">
                <div class="card-header">Assign agent</div>
                <div class="card-body">
                    <form asp-action="Assign" asp-route-id="@ticket.Id" method="post">
                        <select name="agentUserId" class="form-select mb-2">
                            @foreach (ApplicationUser agent in Model.Agents)
                            {
                                <option value="@agent.Id" selected="@(agent.Id == ticket.AssignedAgentId)">@agent.Email</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-primary btn-sm">Assign</button>
                    </form>
                </div>
            </div>
        }

        @if (Model.CanManage)
        {
            <div class="card mb-3">
                <div class="card-header">Manage ticket</div>
                <div class="card-body">
                    <form asp-action="UpdateStatus" asp-route-id="@ticket.Id" method="post" class="mb-3">
                        <label class="form-label">Status</label>
                        <div class="input-group">
                            <select name="status" class="form-select">
                                @foreach (TicketStatus status in Enum.GetValues(typeof(TicketStatus)))
                                {
                                    <option value="@status" selected="@(status == ticket.Status)">@status</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-outline-primary">Save</button>
                        </div>
                    </form>

                    <form asp-action="UpdatePriority" asp-route-id="@ticket.Id" method="post" class="mb-3">
                        <label class="form-label">Priority</label>
                        <div class="input-group">
                            <select name="priority" class="form-select">
                                @foreach (TicketPriority priority in Enum.GetValues(typeof(TicketPriority)))
                                {
                                    <option value="@priority" selected="@(priority == ticket.Priority)">@priority</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-outline-primary">Save</button>
                        </div>
                    </form>

                    <form asp-action="SaveResolution" asp-route-id="@ticket.Id" method="post">
                        <label class="form-label">Resolution details</label>
                        <textarea name="resolutionDetails" class="form-control mb-2" rows="4" maxlength="4000">@ticket.ResolutionDetails</textarea>
                        <button type="submit" class="btn btn-outline-primary btn-sm">Save resolution</button>
                        <div class="form-text">Write this before you set the status to Resolved or Closed.</div>
                    </form>
                </div>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header">History</div>
            <ul class="list-group list-group-flush small">
                @foreach (TicketHistory item in Model.History)
                {
                    <li class="list-group-item">
                        <strong>@item.FieldName</strong>
                        @if (!string.IsNullOrEmpty(item.OldValue))
                        {
                            <span>: @item.OldValue &rarr; @item.NewValue</span>
                        }
                        else
                        {
                            <span>: @item.NewValue</span>
                        }
                        <div class="text-muted">@(item.Actor != null ? item.Actor.Email : "") - @item.CreatedAt.ToString("dd MMM HH:mm")</div>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
