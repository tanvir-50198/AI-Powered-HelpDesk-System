@model TicketListViewModel
@{
    ViewData["Title"] = "Tickets";
    TicketFilter filter = Model.Filter;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Tickets</h2>
    @if (User.IsInRole(Roles.Customer))
    {
        <a class="btn btn-primary" asp-action="Create">New ticket</a>
    }
</div>

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <input type="text" name="Search" value="@filter.Search" class="form-control" placeholder="Search title or description" />
        </div>
        <div class="col-md-2">
            <select name="Status" class="form-select">
                <option value="">All statuses</option>
                @foreach (TicketStatus status in Enum.GetValues(typeof(TicketStatus)))
                {
                    <option value="@status" selected="@(filter.Status == status)">@status</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="Priority" class="form-select">
                <option value="">All priorities</option>
                @foreach (TicketPriority priority in Enum.GetValues(typeof(TicketPriority)))
                {
                    <option value="@priority" selected="@(filter.Priority == priority)">@priority</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="CategoryId" class="form-select">
                <option value="">All categories</option>
                @foreach (Category category in Model.Categories)
                {
                    <option value="@category.Id" selected="@(filter.CategoryId == category.Id)">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="SortBy" class="form-select">
                <option value="newest" selected="@(filter.SortBy == "newest")">Newest first</option>
                <option value="oldest" selected="@(filter.SortBy == "oldest")">Oldest first</option>
                <option value="priority" selected="@(filter.SortBy == "priority")">Highest priority</option>
                <option value="status" selected="@(filter.SortBy == "status")">By status</option>
            </select>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-primary w-100">Go</button>
        </div>
    </div>
    @if (Model.IsAdmin)
    {
        <div class="form-check mt-2">
            <input type="checkbox" class="form-check-input" id="onlyUnassigned" name="OnlyUnassigned" value="true" checked="@filter.OnlyUnassigned" />
            <label class="form-check-label" for="onlyUnassigned">Only tickets without an agent</label>
        </div>
    }
</form>

<div class="card">
    <div class="card-body">
        <partial name="_TicketTable" model="Model.Result.Items" />
    </div>
</div>

@if (Model.Result.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int pageNumber = 1; pageNumber <= Model.Result.TotalPages; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.Result.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-Page="@pageNumber"
                       asp-route-Search="@filter.Search"
                       asp-route-Status="@filter.Status"
                       asp-route-Priority="@filter.Priority"
                       asp-route-CategoryId="@filter.CategoryId"
                       asp-route-SortBy="@filter.SortBy"
                       asp-route-OnlyUnassigned="@filter.OnlyUnassigned">@pageNumber</a>
                </li>
            }
        </ul>
    </nav>
}
<p class="text-muted small text-center">@Model.Result.TotalCount ticket(s) found</p>
