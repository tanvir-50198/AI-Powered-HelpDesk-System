# Where the ASP.NET API listens during development (Vite proxies /api to it)
VITE_API_PROXY_TARGET=http://localhost:5080

# Show one-click demo accounts on the login page (the seeded users from DbSeeder.cs).
# Turn this OFF for any real deployment.
VITE_SHOW_DEMO_ACCOUNTS=true

# Only if you host the SPA under a sub-path of the ASP.NET site, e.g. /app/
# VITE_BASE=/app/
